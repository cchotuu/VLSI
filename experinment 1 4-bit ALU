        );
    end component;

    signal A        : STD_LOGIC_VECTOR(3 downto 0) := "0000";
    signal B        : STD_LOGIC_VECTOR(3 downto 0) := "0000";
    signal Sel      : STD_LOGIC_VECTOR(2 downto 0) := "000";
    signal Result   : STD_LOGIC_VECTOR(3 downto 0);
    signal CarryOut : STD_LOGIC;

begin

    uut: alu_4bit
        port map (
            A        => A,
            B        => B,
            Sel      => Sel,
            Result   => Result,
            CarryOut => CarryOut
        );

    stim_proc: process
    begin

        -- Input values
        A <= "1010";
        B <= "0011";

        -- Test 1: Addition
        Sel <= "000";
        wait for 20 ns;

        -- Test 2: Subtraction
        Sel <= "001";
        wait for 20 ns;

        -- Test 3: Increment A
        Sel <= "010";
        wait for 20 ns;

        -- Test 4: Decrement A
        Sel <= "011";
        wait for 20 ns;

        -- Test 5: AND
        Sel <= "100";
        wait for 20 ns;

        -- Test 6: OR
        Sel <= "101";
        wait for 20 ns;

        -- Test 7: XOR
        Sel <= "110";
        wait for 20 ns;

        -- Test 8: NOT A
        Sel <= "111";
        wait for 20 ns;

        -- Change inputs
        A <= "0101";
        B <= "0101";

        -- Test 9: XOR
        Sel <= "110";
        wait for 20 ns;

        -- Test 10: Addition
        Sel <= "000";
        wait for 20 ns;

        -- Stop simulation
        wait;

    end process;

